    <!-- Marcas de parada (solo visuales): frenar con el eje de las ruedas de tracción (atrás) sobre la franja,
         ~0,3 m antes del tronco de cada árbol izquierdo. Ahí los 3 limones de ese árbol quedan en la zona que ve el
         estéreo y al alcance del brazo (calculado con la base de la R2 E3, el brazo sobre el eje y el mástil adelante
         a la derecha). Tolerancia: ±2 cm en x, sobre el centro del pasillo (y = 0). -->
    <model name="parada_1">
      <static>true</static>
      <pose>1.19 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.04 0.9 0.004</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
      </link>
    </model>
    <model name="parada_2">
      <static>true</static>
      <pose>2.70 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.04 0.9 0.004</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
      </link>
    </model>
    <model name="parada_3">
      <static>true</static>
      <pose>4.17 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.04 0.9 0.004</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
      </link>
    </model>
    <model name="parada_4">
      <static>true</static>
      <pose>5.69 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.04 0.9 0.004</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
      </link>
    </model>

    <!-- Punto de regreso al final de la hilera (marca en el piso, sin colisión) -->
    <model name="regreso">
      <static>true</static>
      <pose>7.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
