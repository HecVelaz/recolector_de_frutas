<?xml version="1.0"?>
<!-- Arturito R2D2 en Gazebo Harmonic: base diferencial con IMU y GPS + brazo RRR y pinza.
     Mismos marcos y tópicos que firmware/base: /cmd_vel, /odom (odom -> base_link), /imu/data_raw (imu_link),
     /gps/fix (gps_link). Base de la R2 E3: caja de madera en T, 40 cm de largo; adelante la parte ancha (40 x 23 cm,
     donde va el brazo), atrás la angosta (34 x 17 cm) con las ruedas de tracción en rebajes de 3 cm; paredes de 18 cm.
     Ruedas inflables de 150 mm (docs/fotos/rueda). Lo marcado MEDIR es estimado. -->
<robot name="arturito" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="radio" value="0.075"/>      <!-- CFG_DIF.radioRueda: 150 mm, inflable (MEDIR con el inflado) -->
  <xacro:property name="trocha" value="0.40"/>      <!-- CFG_DIF.trocha: entre centros de rueda (MEDIR) -->
  <xacro:property name="ancho_rueda" value="0.045"/>
  <xacro:property name="eje_atras" value="0.085"/>  <!-- eje: ranura centrada en el lateral de 17 cm (R2 E3, Lateral_Ejes) -->
  <xacro:property name="largo_angosto" value="0.17"/>
  <xacro:property name="ancho_angosto" value="0.34"/>
  <xacro:property name="largo_ancho" value="0.23"/>
  <xacro:property name="ancho_ancho" value="0.40"/>
  <xacro:property name="alto_caja" value="0.20"/>   <!-- paredes de 18 cm + base y tapa de 1 cm -->
  <xacro:property name="piso" value="0.03"/>        <!-- base de la caja sobre el piso: ranura del eje de 5 cm, ~2-3 cm (MEDIR) -->
  <xacro:property name="abajo" value="${piso - radio}"/>        <!-- base de la caja respecto de base_link -->
  <xacro:property name="alto" value="${abajo + alto_caja}"/>    <!-- tapa respecto de base_link (0,23 m del piso) -->
  <xacro:property name="frente" value="${largo_angosto - eje_atras + largo_ancho}"/>  <!-- frente respecto del eje -->
  <xacro:property name="r_rueda_loca" value="0.03"/>

  <xacro:macro name="inercia_caja" params="m x y z">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- base_link en el centro del eje de las ruedas de tracción (atrás), a la altura del radio -->
  <link name="base_link">
    <visual>
      <origin xyz="${largo_angosto/2 - eje_atras} 0 ${abajo + alto_caja/2}"/>
      <geometry><box size="${largo_angosto} ${ancho_angosto} ${alto_caja}"/></geometry>
      <material name="gris"><color rgba="0.25 0.25 0.27 1"/></material>
    </visual>
    <visual>
      <origin xyz="${frente - largo_ancho/2} 0 ${abajo + alto_caja/2}"/>
      <geometry><box size="${largo_ancho} ${ancho_ancho} ${alto_caja}"/></geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <origin xyz="${largo_angosto/2 - eje_atras} 0 ${abajo + alto_caja/2}"/>
      <geometry><box size="${largo_angosto} ${ancho_angosto} ${alto_caja}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${frente - largo_ancho/2} 0 ${abajo + alto_caja/2}"/>
      <geometry><box size="${largo_ancho} ${ancho_ancho} ${alto_caja}"/></geometry>
    </collision>
    <!-- 20 kg (MEDIR): madera, batería de 36 V, 2 motores de ~1 kg, drivers -->
    <inertial><origin xyz="0.10 0 ${abajo + alto_caja/2}"/><mass value="20.0"/>
      <inertia ixx="0.29" iyy="0.33" izz="0.53" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <xacro:macro name="rueda" params="lado signo">
    <link name="rueda_${lado}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${radio}" length="${ancho_rueda}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${radio}" length="${ancho_rueda}"/></geometry>
      </collision>
      <inertial><mass value="0.65"/>  <!-- 650 g por rueda -->
        <inertia ixx="0.00102" iyy="0.00183" izz="0.00102" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="rueda_${lado}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${lado}"/>
      <origin xyz="0 ${signo*trocha/2} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:rueda lado="izq" signo="1"/>
  <xacro:rueda lado="der" signo="-1"/>

  <!-- Dos ruedas locas bajo la parte ancha (adelante), sin fricción (MEDIR la posición) -->
  <xacro:macro name="rueda_loca" params="nombre y">
    <link name="${nombre}">
      <visual><geometry><sphere radius="${r_rueda_loca}"/></geometry><material name="negro"/></visual>
      <collision><geometry><sphere radius="${r_rueda_loca}"/></geometry></collision>
      <inertial><mass value="0.1"/><inertia ixx="4e-5" iyy="4e-5" izz="4e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${nombre}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${nombre}"/>
      <origin xyz="${frente - 0.05} ${y} ${r_rueda_loca - radio}"/>
    </joint>
    <gazebo reference="${nombre}"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:rueda_loca nombre="rueda_loca_izq" y="0.13"/>
  <xacro:rueda_loca nombre="rueda_loca_der" y="-0.13"/>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0.10 0 ${abajo + 0.03}"/>
  </joint>
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/><origin xyz="0 -0.10 ${alto + 0.05}"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <topic>navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================== Ultrasonidos y bumpers (etapa 5) =====================
       3 HC-SR04 (en el frente, a 14 cm del piso) y 3 bumpers de madera de 10 x 5 cm
       (R2 E3) abajo, a 6 cm del piso, que sobresalen 1 cm, con resorte. Ubicación: MEDIR. base_sim lee los sensores por
       gz-transport y publica /range/* y /bumpers como la S3. Cada HC-SR04 es un gpu_lidar de 5 rayos en un abanico
       horizontal de ~15° (field_of_view del firmware): base_sim toma el eco más cercano. Sin rayos hacia abajo: a
       14 cm de altura, el de -7,5° veía el piso a 1,07 m (el HC-SR04 real casi no tiene eco del piso liso). -->
  <xacro:property name="z_us" value="${0.14 - radio}"/>
  <xacro:property name="z_bumper" value="${0.06 - radio}"/>
  <xacro:macro name="ultrasonido" params="nombre x y yaw">
    <link name="us_${nombre}">
      <visual><geometry><box size="0.015 0.045 0.02"/></geometry><material name="azul"/></visual>
    </link>
    <joint name="us_${nombre}_joint" type="fixed">
      <parent link="base_link"/><child link="us_${nombre}"/><origin xyz="${x} ${y} ${z_us}" rpy="0 0 ${yaw}"/>
    </joint>
    <gazebo reference="us_${nombre}">
      <sensor name="us_${nombre}" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/sim/us_${nombre}</topic>
        <lidar>
          <scan>
            <horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.13</min_angle><max_angle>0.13</max_angle></horizontal>
          </scan>
          <range><min>0.02</min><max>4.0</max></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <!-- Los 3 en el frente: el central recto y los de las esquinas abiertos 15°. Mirando a los costados, un
       obstáculo corrido hacia un lado del pasillo no lo veía ninguno hasta chocarlo con la esquina (el haz del
       central cubre ±7,5°). Abiertos y no paralelos: con el TRIG común, paralelos se oirían entre ellos -->
  <xacro:ultrasonido nombre="frente" x="${frente + 0.008}" y="0" yaw="0"/>
  <xacro:ultrasonido nombre="izq" x="${frente + 0.008}" y="0.15" yaw="${radians(15)}"/>
  <xacro:ultrasonido nombre="der" x="${frente + 0.008}" y="-0.15" yaw="${radians(-15)}"/>

  <xacro:macro name="bumper" params="nombre x y yaw">
    <link name="bumper_${nombre}">
      <visual><geometry><box size="0.01 0.10 0.05"/></geometry>
        <material name="madera"><color rgba="0.75 0.6 0.4 1"/></material></visual>
      <collision><geometry><box size="0.01 0.10 0.05"/></geometry></collision>
      <inertial><mass value="0.05"/><inertia ixx="5e-5" iyy="1e-5" izz="4e-5" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <!-- Plancha con resorte (como la real): se hunde hasta 1 cm hacia el cuerpo; base_sim la da por apretada
         (final de carrera) con más de 3 mm. El sensor de contacto de Gazebo no informaba nada en links fijos -->
    <joint name="bumper_${nombre}_joint" type="prismatic">
      <parent link="base_link"/><child link="bumper_${nombre}"/><origin xyz="${x} ${y} ${z_bumper}" rpy="0 0 ${yaw}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.01" upper="0" effort="100" velocity="1"/>
      <dynamics damping="2.0"/>
    </joint>
    <gazebo reference="bumper_${nombre}_joint">
      <springStiffness>300</springStiffness>
      <springReference>0</springReference>
    </gazebo>
  </xacro:macro>
  <xacro:bumper nombre="frente" x="${frente + 0.015}" y="0" yaw="0"/>
  <xacro:bumper nombre="izq" x="${frente - largo_ancho/2}" y="${ancho_ancho/2 + 0.015}" yaw="${pi/2}"/>
  <xacro:bumper nombre="der" x="${frente - largo_ancho/2}" y="${-(ancho_ancho/2 + 0.015)}" yaw="${-pi/2}"/>

  <gazebo>
    <!-- Tracción diferencial con los límites de CFG_DIF (v 0,25 m/s, w 1 rad/s, a 0,3 m/s², alfa 1,5 rad/s²) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rueda_izq_joint</left_joint>
      <right_joint>rueda_der_joint</right_joint>
      <wheel_separation>${trocha}</wheel_separation>
      <wheel_radius>${radio}</wheel_radius>
      <max_linear_velocity>0.25</max_linear_velocity>
      <min_linear_velocity>-0.25</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_linear_acceleration>0.3</max_linear_acceleration>
      <min_linear_acceleration>-0.3</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>25</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- sin esto sale en cada paso de física (1 kHz): ahogaba a los nodos de Python y la consigna del brazo llegaba
           a saltos (temblor) -->
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ===================== Brazo (etapa 2) =====================
       Montado atrás a la izquierda, sobre el eje de las ruedas de tracción, a ~6 cm del costado (preliminar); J1 = 0°
       mira al frente, paralelo al costado. Medidas de la E4 (brazo_ik/cinematica.py). El cuatro barras se simula como
       la cadena serie equivalente: j2 = q2 (hombro) y j3o = q3O (antebrazo respecto de la prolongación de l2);
       brazo_sim convierte el actuador q3 <-> q3O. Articulaciones movidas por velocidad (JointPositionController con
       use_velocity_commands): la gravedad no las afloja, como el sin fin de J2/J3. -->
  <xacro:property name="brazo_x" value="0.0"/>  <!-- sobre el eje de tracción (MEDIR) -->
  <xacro:property name="brazo_y" value="${ancho_angosto/2 - 0.06}"/>  <!-- a ~6 cm del costado izquierdo de la parte angosta -->
  <!-- Masas del brazo al 5 %: las articulaciones se mueven por velocidad (fuerza ilimitada) y, con las masas reales,
       cada movimiento hacía deslizar la base con las ruedas frenadas (~2-7 cm y 1,5-5° por movimiento). El brazo se
       controla cinemáticamente (brazo_sim), así que su masa no se usa para nada más -->
  <xacro:property name="k_masa" value="0.05"/>
  <xacro:property name="H1" value="0.150"/>
  <xacro:property name="L2" value="0.35022"/>
  <xacro:property name="L3" value="0.32951"/>
  <xacro:property name="largo_pinza" value="0.11"/>  <!-- muñeca P3 -> punta de los dedos (MEDIR) -->
  <xacro:property name="largo_tcp" value="0.075"/>   <!-- muñeca P3 -> punto de agarre, entre los dedos (MEDIR); = largo_herramienta de brazo_ik -->

  <xacro:macro name="barra" params="nombre largo_b ancho_b m color">
    <link name="${nombre}">
      <visual><origin xyz="${largo_b/2} 0 0"/><geometry><box size="${largo_b} ${ancho_b} ${ancho_b}"/></geometry>
        <material name="${color}"/></visual>
      <collision><origin xyz="${largo_b/2} 0 0"/><geometry><box size="${largo_b} ${ancho_b} ${ancho_b}"/></geometry></collision>
      <inertial><origin xyz="${largo_b/2} 0 0"/><mass value="${m}"/>
        <inertia ixx="${m*2*ancho_b*ancho_b/12}" iyy="${m*(largo_b*largo_b+ancho_b*ancho_b)/12}"
                 izz="${m*(largo_b*largo_b+ancho_b*ancho_b)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
  </xacro:macro>

  <link name="brazo_base"/>
  <joint name="brazo_base_joint" type="fixed">
    <parent link="base_link"/><child link="brazo_base"/><origin xyz="${brazo_x} ${brazo_y} ${alto}"/>
  </joint>

  <link name="torreta">
    <visual><origin xyz="0 0 ${H1/2}"/><geometry><cylinder radius="0.04" length="${H1}"/></geometry>
      <material name="naranja"><color rgba="0.9 0.45 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 ${H1/2}"/><geometry><cylinder radius="0.04" length="${H1}"/></geometry></collision>
    <xacro:inercia_caja m="${0.8*k_masa}" x="0.08" y="0.08" z="${H1}"/>
  </link>
  <joint name="j1" type="revolute">
    <parent link="brazo_base"/><child link="torreta"/><axis xyz="0 0 1"/>
    <limit lower="${radians(45)}" upper="${radians(225)}" effort="50" velocity="1.0"/>
  </joint>

  <material name="verde"><color rgba="0.1 0.6 0.2 1"/></material>
  <material name="azul"><color rgba="0.1 0.3 0.8 1"/></material>
  <xacro:barra nombre="l2" largo_b="${L2}" ancho_b="0.03" m="${0.5*k_masa}" color="verde"/>
  <joint name="j2" type="revolute">
    <!-- eje -y: q2 positivo levanta la barra (q2 desde la horizontal, como en la E4) -->
    <parent link="torreta"/><child link="l2"/><origin xyz="0 0 ${H1}"/><axis xyz="0 -1 0"/>
    <limit lower="${radians(-25)}" upper="${radians(135)}" effort="50" velocity="1.0"/>
  </joint>
  <xacro:barra nombre="l3" largo_b="${L3}" ancho_b="0.025" m="${0.4*k_masa}" color="azul"/>
  <joint name="j3o" type="revolute">
    <parent link="l2"/><child link="l3"/><origin xyz="${L2} 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="${radians(-175)}" upper="${radians(10)}" effort="50" velocity="1.0"/>
  </joint>

  <!-- Brazo tipo uArm / Dobot Magician: un paralelogramo mantiene la herramienta horizontal, apuntando en la dirección
       de J1 (E1). Se simula con j_nivel en la muñeca, al que brazo_sim le manda -(q2 + q3O) -->
  <link name="muneca">
    <inertial><mass value="${0.05*k_masa}"/><inertia ixx="${1e-5*k_masa}" iyy="${1e-5*k_masa}" izz="${1e-5*k_masa}" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="j_nivel" type="revolute">
    <parent link="l3"/><child link="muneca"/><origin xyz="${L3} 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="3.0"/>
  </joint>

  <!-- Pinza: giro J4 alrededor del eje de la herramienta (horizontal) y dos dedos (servos RDS3218) -->
  <link name="pinza">
    <visual><origin xyz="0.02 0 0"/><geometry><box size="0.04 0.09 0.03"/></geometry><material name="gris"/></visual>
    <collision><origin xyz="0.02 0 0"/><geometry><box size="0.04 0.09 0.03"/></geometry></collision>
    <xacro:inercia_caja m="${0.2*k_masa}" x="0.04" y="0.09" z="0.03"/>
  </link>
  <joint name="j4" type="revolute">
    <parent link="muneca"/><child link="pinza"/><axis xyz="1 0 0"/>
    <limit lower="${radians(-90)}" upper="${radians(90)}" effort="20" velocity="3.0"/>
  </joint>
  <xacro:macro name="dedo" params="lado signo">
    <link name="dedo_${lado}">
      <visual><origin xyz="${(largo_pinza - 0.04)/2} 0 0"/><geometry><box size="${largo_pinza - 0.04} 0.01 0.025"/></geometry>
        <material name="negro"/></visual>
      <!-- sin colisión: el agarre en la simulación se hará fijando el limón a la pinza al cerrar (etapa 4) -->
      <xacro:inercia_caja m="${0.05*k_masa}" x="${largo_pinza - 0.04}" y="0.01" z="0.025"/>
    </link>
    <!-- Sin gravedad: con la pinza girada, el control por velocidad de Gazebo no sostenía el peso de los dedos (uno
         caía al tope); el servo real sí los sostiene -->
    <gazebo reference="dedo_${lado}"><turnGravityOff>true</turnGravityOff></gazebo>
    <joint name="dedo_${lado}_joint" type="prismatic">
      <!-- 0 = cerrada; 0,045 m = abierta (cada dedo: entra un limón de 56 mm). La cara interna queda a la distancia
           del prismático del eje de la herramienta -->
      <parent link="pinza"/><child link="dedo_${lado}"/><origin xyz="0.04 ${signo*0.005} 0"/><axis xyz="0 ${signo} 0"/>
      <limit lower="0" upper="0.045" effort="20" velocity="0.2"/>
    </joint>
  </xacro:macro>
  <xacro:dedo lado="izq" signo="1"/>
  <xacro:dedo lado="der" signo="-1"/>
  <!-- Punto de agarre (TCP): ahí se engancha el limón y ahí apunta /brazo/objetivo -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="pinza"/><child link="tcp"/><origin xyz="${largo_tcp} 0 0"/>
  </joint>

  <xacro:macro name="control_posicion" params="joint topico ini ganancia">
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>${joint}</joint_name>
      <topic>${topico}</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>${ganancia}</p_gain>
      <cmd_max>2.0</cmd_max>
      <cmd_min>-2.0</cmd_min>
      <initial_position>${ini}</initial_position>
    </plugin>
  </xacro:macro>
  <!-- J1-J3 y el nivelador, por velocidad: brazo_sim manda la del perfil más una corrección del error. Con
       JointPositionController (use_velocity_commands) Gazebo intentaba llegar a cada consigna en un paso de física
       (±1 rad/s y frenar, 50 veces por segundo): el brazo temblaba -->
  <xacro:macro name="control_velocidad" params="joint topico">
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>${joint}</joint_name>
      <topic>${topico}</topic>
    </plugin>
  </xacro:macro>
  <gazebo>
    <!-- Aparecen en 0 y brazo_sim las lleva al reposo -->
    <xacro:control_velocidad joint="j1" topico="/sim/j1"/>
    <xacro:control_velocidad joint="j2" topico="/sim/j2"/>
    <xacro:control_velocidad joint="j3o" topico="/sim/j3o"/>
    <xacro:control_velocidad joint="j_nivel" topico="/sim/j_nivel"/>
    <xacro:control_posicion joint="j4" topico="/sim/j4" ini="0" ganancia="10"/>
    <!-- Un tópico por dedo: dos controladores en el mismo tópico no reciben los dos -->
    <xacro:control_posicion joint="dedo_izq_joint" topico="/sim/dedo_izq" ini="0.045" ganancia="10"/>
    <xacro:control_posicion joint="dedo_der_joint" topico="/sim/dedo_der" ini="0.045" ganancia="10"/>
  </gazebo>
  <!-- ===================== Cámaras y agarre (etapa 4) =====================
       stereo_camera_link = cámara izquierda (x adelante, z arriba), en un mástil adelante a la DERECHA, a 0,85 m del
       piso, mirando 94° a la izquierda (de costado, hacia la fila, por encima del robot) y 28° hacia abajo (MEDIR con
       el soporte rígido). El estéreo solo localiza en la parte derecha de la imagen izquierda (u >= 271 px: con
       disparidad mínima 112 y rango 160, más a la izquierda la búsqueda se sale de la imagen derecha) y a 0,4-0,95 m.
       Posición y ángulos buscados (brazo sobre el eje): para que desde cada marca de parada los 3 limones del árbol
       caigan ahí y al alcance de J1 (±75°). Del lado izquierdo, pegada a la fila, quedaba demasiado cerca: los 3
       limones ocupaban ~26° y la zona útil de la imagen tiene ~19°. Tolerancia de parada: ±2 cm.
       "camera" es el marco óptico, con la misma rotación que publica limon.launch.py de vision_estereo:
       /limon/posicion viene ahí. -->
  <xacro:property name="mastil_x" value="${frente - 0.06}"/>          <!-- a ~6 cm del frente (MEDIR) -->
  <xacro:property name="mastil_y" value="${-(ancho_ancho/2 - 0.03)}"/> <!-- a ~3 cm del costado derecho (MEDIR) -->
  <xacro:property name="mastil_alto" value="0.85"/>                    <!-- cámara izquierda sobre el piso (MEDIR) -->
  <!-- Mástil y cámaras dibujados (solo visual): para ver si el brazo las tapa o las toca al moverse -->
  <link name="mastil">
    <visual><origin xyz="0 0 ${(mastil_alto - radio - alto)/2}"/>
      <geometry><cylinder radius="0.012" length="${mastil_alto - radio - alto}"/></geometry>
      <material name="gris"/></visual>
  </link>
  <joint name="mastil_joint" type="fixed">
    <parent link="base_link"/><child link="mastil"/><origin xyz="${mastil_x} ${mastil_y} ${alto}"/>
  </joint>
  <link name="stereo_camera_link">
    <!-- barra de las cámaras (99 mm entre ejes) y los dos "ojos", mirando por +x -->
    <visual><origin xyz="-0.015 -0.0496 0"/><geometry><box size="0.02 0.14 0.02"/></geometry>
      <material name="negro"/></visual>
    <visual><origin xyz="0.005 0 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.01" length="0.02"/></geometry>
      <material name="azul"/></visual>
    <visual><origin xyz="0.005 -0.099258 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.01" length="0.02"/></geometry>
      <material name="azul"/></visual>
  </link>
  <joint name="stereo_camera_joint" type="fixed">
    <parent link="base_link"/><child link="stereo_camera_link"/>
    <origin xyz="${mastil_x} ${mastil_y} ${mastil_alto - radio}" rpy="0 ${radians(28)} ${radians(94)}"/>
  </joint>
  <link name="camera"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="stereo_camera_link"/><child link="camera"/><origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Cámaras estéreo de Gazebo (etapa 3), solo con camaras:=true (renderizar es lo más pesado): como la calibración
       v1, 640x480, f = 1076,5 px (33,1° de campo horizontal) y 99,26 mm de separación (Tx = -106,854). Imágenes
       ideales, sin distorsión: salen directo como /left/image_rect y /right/image_rect (camara_info_sim les pone el
       camera_info). La cámara derecha queda a la derecha de la izquierda (-y de stereo_camera_link). -->
  <xacro:arg name="camaras" default="false"/>
  <xacro:macro name="camara" params="nombre topico marco y">
    <sensor name="${nombre}" type="camera">
      <pose>0 ${y} 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>${topico}</topic>
      <gz_frame_id>${marco}</gz_frame_id>
      <camera>
        <horizontal_fov>${2*atan(320/1076.537901)}</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
    </sensor>
  </xacro:macro>
  <xacro:if value="$(arg camaras)">
    <gazebo reference="stereo_camera_link">
      <xacro:camara nombre="cam_izq" topico="/left/image_rect" marco="camera" y="0"/>
      <xacro:camara nombre="cam_der" topico="/right/image_rect" marco="camera_der" y="-0.099258"/>
    </gazebo>
  </xacro:if>

</robot>
