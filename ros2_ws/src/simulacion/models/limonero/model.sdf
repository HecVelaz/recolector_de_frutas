<?xml version="1.0"?>
<!-- Maqueta de limonero según R1: tronco de 0,23 m y copa entre ~0,21 y 0,53 m (dibujo del árbol de la E2); limones
     entre 0,22 y 0,50 m, dentro de la esfera de trabajo de la consigna (Ø 30 cm, centro a ~35 cm del suelo).
     Estática: estos limones son para la visión; los que se agarran se agregan aparte como modelos sueltos. -->
<sdf version="1.9">
  <model name="limonero">
    <static>true</static>
    <link name="link">
      <collision name="tronco_c">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.23</length></cylinder></geometry>
      </collision>
