<?xml version="1.0"?>
<!-- Maqueta de limonero para la hilera (guía R2: plantas o maquetas representativas). Estática: los limones de esta
     maqueta son solo para la visión; los que se agarran se agregan aparte como modelos sueltos.
     Tronco de 0,6 m, copa de r = 0.35 m centrada a 0.85 m: limones entre ~0,6 y 1,1 m de altura. -->
<sdf version="1.9">
  <model name="limonero">
    <static>true</static>
    <link name="link">
      <collision name="tronco_c">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
      </collision>
      <visual name="tronco">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.26 0.13 1</diffuse></material>
      </visual>
      <collision name="copa_c">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><sphere><radius>0.35</radius></sphere></geometry>
      </collision>
      <visual name="copa">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><sphere><radius>0.35</radius></sphere></geometry>
        <material><ambient>0.05 0.25 0.05 1</ambient><diffuse>0.08 0.35 0.08 1</diffuse></material>
      </visual>
      <visual name="limon_0">
        <pose>0.345 0.000 0.730 0 0 0</pose>
        <geometry><ellipsoid><radii>0.028 0.028 0.034</radii></ellipsoid></geometry>
        <material><ambient>0.35 0.6 0.1 1</ambient><diffuse>0.4 0.7 0.12 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="limon_1">
        <pose>0.277 0.232 0.900 0 0 0</pose>
        <geometry><ellipsoid><radii>0.028 0.028 0.034</radii></ellipsoid></geometry>
