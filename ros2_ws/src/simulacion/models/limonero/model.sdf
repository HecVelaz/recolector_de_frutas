<?xml version="1.0"?>
<!-- Maqueta de limonero según R1: tronco de 0,23 m y copa entre ~0,21 y 0,53 m (dibujo del árbol de la E2).
     Sin frutos: los limones son modelos aparte del mundo (worlds/hilera.sdf). La copa no tiene colisión (son hojas:
     el brazo entra a buscar los limones semitapados); el tronco sí. -->
<sdf version="1.9">
  <model name="limonero">
    <static>true</static>
    <link name="link">
      <collision name="tronco_c">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.23</length></cylinder></geometry>
      </collision>
      <visual name="tronco">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.23</length></cylinder></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.15 0.15 0.15 1</specular><pbr><metal><albedo_map>model://texturas/corteza.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material>
      </visual>
      <visual name="copa">
        <pose>0 0 0.37 0 0 0</pose>
        <geometry><ellipsoid><radii>0.22 0.22 0.16</radii></ellipsoid></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.15 0.15 0.15 1</specular><pbr><metal><albedo_map>model://texturas/hojas.png</albedo_map><roughness>0.8</roughness><metalness>0</metalness></metal></pbr></material>
      </visual>
    </link>
  </model>
</sdf>
