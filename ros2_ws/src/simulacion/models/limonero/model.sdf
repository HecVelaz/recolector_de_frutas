        <geometry><ellipsoid><radii>0.028 0.028 0.034</radii></ellipsoid></geometry>
        <material><ambient>0.35 0.6 0.1 1</ambient><diffuse>0.4 0.7 0.12 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="limon_5">
        <pose>-0.234 -0.196 1.000 0 0 0</pose>
