v 0 0.125 -0.125
v 0 0.125 0.125
v 0 -0.125 0.125
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 1 0 0
usemtl marca
f 1/1/1 2/2/1 3/3/1 4/4/1
