<mxfile host="drawio"><diagram name="fig_hardware_brazo"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Hardware del brazo (diseño final): sensores, controlador, drivers y actuadores" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 × cámara Pi Camera Module 3 NoIR&lt;/b&gt;&lt;br&gt;estéreo, baseline 90 mm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Raspberry Pi 5&lt;/b&gt;&lt;br&gt;YOLO + estéreo → posición del limón&lt;br&gt;cinemática inversa → q1, q2, q3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="420" height="110" as="geometry"/></mxCell><mxCell id="c6" value="CSI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ESP32-WROOM-32D&lt;/b&gt;&lt;br&gt;control en cascada de J1-J3 (10 ms)&lt;br&gt;homing · protecciones · pinza" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="420" height="110" as="geometry"/></mxCell><mxCell id="c8" value="USB · micro-ROS" style="edgeStyle=orthogonalEdge