33;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="751.0" y="711.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="c19" style="ellipse;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="785.2" y="221.9" width="18" height="18" as="geometry"/></mxCell><mxCell id="c20" style="ellipse;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="815.3" y="657.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="c21" style="ellipse;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="826.4" y="183.9" width="18" height="18" as="geometry"/></mxCell><mxCell id="c22" style="ellipse;fillColor=#333333;strokeColor=#333333;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="444.0" y="532.5" width="22" height="22" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Cuatro barras del codo con el balancín rojo de 60 mm&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Dibujo a escala, en la pose de reposo q&lt;sub&gt;2&lt;/sub&gt; = 94°, q&lt;sub&gt;3&lt;/sub&gt; = −50°" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Hombro&lt;/b&gt;&lt;br&gt;J2 mueve la barra verde&lt;br&gt;J3 mueve el balancín rojo" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430.0" y="710.0" width="300" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Balancín rojo L&lt;sub&gt;3,0&lt;/sub&gt; = 60 mm&lt;/b&gt;&lt;br&gt;(en la E4 medía 40 mm)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930.0" y="646.0" width="340" height="60" as="geometry"/></mxCell><mxCell id="c27" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="924.0" y="676.0" as="sourcePoint"/><mxPoint x="838.3" y="670.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Eslabón de salida L&lt;sub&gt;3,1&lt;/sub&gt; = 40 mm&lt;/b&gt;&lt;br&gt;tramo corto del antebrazo" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930.0" y="232.9" width="360" height="60" as="geometry"/></mxCell><mxCell id="c29" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="924.0" y="262.9" as="sourcePoint"/><mxPoint x="847.4" y="200.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Acoplador L&lt;sub&gt;4&lt;/sub&gt; = 338 mm&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930.0" y="409.5" width="340" height="40" as="geometry"/></mxCell><mxCell id="c31" style="endArrow=classic;html=1;strokeColor=#555555;strokeWidth=1.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="924.0" y="429.5" as="sourcePoint"/><mxPoint x="837.9" y="429.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Codo&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="654.2" y="190.9" width="120" height="30" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Barra verde L&lt;sub&gt;2&lt;/sub&gt; = 350,22 mm&lt;/b&gt;&lt;br&gt;(eslabón fijo del cuatro barras)" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410.0" y="575.4" width="340" height="60" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Antebrazo L&lt;sub&gt;3&lt;/sub&gt; = 329,51 mm&lt;/b&gt;&lt;br&gt;hasta la muñeca" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85.0" y="513.5" width="330" height="60" as="geometry"/></mxCell><mxCell id="c35" value="Base giratoria (J1)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860.0" y="920.0" width="250" height="40" as="geometry"/></mxCell><mxCell id="c36" value="Grashof: 40 + 350,22 = 390,22 ≤ 60 + 338 = 398 → se cumple" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="980.0" width="1000" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>