<mxfile host="drawio"><diagram name="fig_lazo_abierto"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Ensayos en lazo abierto: se aplica un PWM fijo y solo se mide (sin realimentación)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;PC&lt;/b&gt;&lt;br&gt;script de Python:&lt;br&gt;manda el ensayo,&lt;br&gt;guarda el CSV y grafica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ESP32&lt;/b&gt;&lt;br&gt;genera el perfil de PWM&lt;br&gt;(barrido, escalón,&lt;br&gt;escalera, rampa)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="260" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;IBT-2 (J1)&lt;br&gt;L298N (5840, E5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="220" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Motor + reductora&lt;/b&gt;&lt;br&gt;eje libre&lt;br&gt;o con carga" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="240" height="140" as="geometry"/></mxCell><mxCel