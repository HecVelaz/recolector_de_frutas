ackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="El encoder solo registra la respuesta: el PWM no se corrige con la medición (eso recién se hace en lazo cerrado, Entrega 6)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1450" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>