<mxfile host="drawio"><diagram name="fig2_morfologia"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Morfología: brazo RRR tipo uArm/Dobot sobre la base móvil (3 GDL de posición + 2 de la pinza)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Base móvil (R2)&lt;/b&gt;&lt;br&gt;caja de madera en T&lt;br&gt;tracción diferencial&lt;br&gt;(no evalúa R1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;J1 · base giratoria&lt;/b&gt;&lt;br&gt;R, eje vertical&lt;br&gt;q1 = 45° a 225°&lt;br&gt;36GP-555 + correa&lt;br&gt;GT2 18 → 90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="250" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;J2 · hombro&lt;/b&gt;&lt;br&gt;R, eje horizontal&lt;br&gt;q2 = −25° a 135°&lt;br&gt;36-555 + engranajes&lt;br&gt;helicoidales 15 → 75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="250" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;J3 · codo&lt;/b&gt;&lt;br&gt;R, por cuatro barras&lt;br&gt;q3 = −50° a 50°&lt;br&gt;36-555 + engranajes&lt;br&gt;helicoidales 15 → 75" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="250" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Pinza&lt;/b&gt;&lt;br&gt;J4: giro (servo)&lt;br&gt;apertura (servo)&lt;br&gt;agarre + tracción + giro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="250" height="150" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Motor de J3 abajo&lt;/b&gt;&lt;br&gt;mueve el balancín de 40 mm;&lt;br&gt;el acoplador de 338 mm lleva&lt;br&gt;el giro hasta el codo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="250" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Paralelogramo&lt;/b&gt;&lt;br&gt;mantiene la herramienta&lt;br&gt;siempre horizontal,&lt;br&gt;en la dirección de J1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="250" height="120" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c13" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c14" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Configuración&lt;/b&gt;&lt;br&gt;RRR articulada (angular)&lt;br&gt;espacio de trabajo esférico&lt;br&gt;altura del hombro H1 = 150 mm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="250" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Ubicación&lt;/b&gt;&lt;br&gt;atrás a la izquierda,&lt;br&gt;sobre el eje de tracción&lt;br&gt;(no cruza el mástil de cámaras)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="250" height="120" as="geometry"/></mxCell><mxCell id="c19" value="Azul: articulaciones motorizadas con encoder (diseño final; los 36-555 de J2/J3 llegan del 19 al 29/10). Verde: efector final. Amarillo: mecanismos pasivos." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1430" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>