<mxfile host="drawio"><diagram name="fig_fabricacion"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Fabricación y montaje del brazo: del CAD a la demo" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. CAD&lt;/b&gt;&lt;br&gt;SolidWorks:&lt;br&gt;eslabones, base,&lt;br&gt;pinza y soportes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="300" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. Laminado&lt;/b&gt;&lt;br&gt;STL → G-code&lt;br&gt;(orientación y&lt;br&gt;soportes por pieza)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="300" height="150" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;3. Impresión FDM&lt;/b&gt;&lt;br&gt;PLA-CF negro&lt;br&gt;1,75 mm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="300" height="150" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4. Post-proceso&lt;/b&gt;&lt;br&gt;quitar soportes,&lt;br&gt;lijar y repasar&lt;br&gt;agujeros de ejes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="300" height="150" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;5. Subconjuntos&lt;/b&gt;&lt;br&gt;rodamientos, ejes,&lt;br&gt;polea GT2 (J1), engranajes&lt;br&gt;(J2, J3), motores y servos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="300" height="150" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;6. Montaje&lt;/b&gt;&lt;br&gt;brazo sobre la base&lt;br&gt;de madera,&lt;br&gt;correa de J1 tensada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="280" width="300" height="150" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;7. Cableado&lt;/b&gt;&lt;br&gt;shield de borneras,&lt;br&gt;IBT-2, encoders,&lt;br&gt;finales de carrera" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="300" height="150" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;8. Pruebas&lt;/b&gt;&lt;br&gt;lazo abierto,&lt;br&gt;lazo cerrado&lt;br&gt;y demo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1130" y="280" width="300" height="150" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Si una pieza falla en el montaje o en las pruebas, se corrige en el CAD y se vuelve a imprimir (pasos 1 a 4)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1430" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>