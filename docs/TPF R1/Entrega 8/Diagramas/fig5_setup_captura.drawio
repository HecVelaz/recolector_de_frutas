oundColor=#ffffff;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="400" as="sourcePoint"/><mxPoint x="835" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="0,38 m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;startArrow=block;startFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="884" y="700" as="sourcePoint"/><mxPoint x="700" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="0,96 m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=2;startArrow=block;startFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="884" y="750" as="sourcePoint"/><mxPoint x="410" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="baseline 89,5 mm" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="940" y="470" width="170" height="24" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Datos del setup&lt;/b&gt;&lt;br&gt;• 2 × Pi Camera Module 3 NoIR (IMX708), foco fijo&lt;br&gt;• soporte rígido, cámaras separadas 89,5 mm (calibrado)&lt;br&gt;• 640 × 480 a partir del sensor completo (2304 × 1296)&lt;br&gt;• 30 FPS fijos; la cadena estéreo usa 10 FPS&lt;br&gt;• campo horizontal ≈ 52° (f = 654 px)&lt;br&gt;• distancia de trabajo: 0,38 a 0,96 m&lt;br&gt;• las cámaras miran a la hilera, por encima de la base&lt;br&gt;• altura e inclinación: a medir al montar el mástil" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="470" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
