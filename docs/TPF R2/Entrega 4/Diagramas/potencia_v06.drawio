<mxfile host="drawio"><diagram name="potencia_v06"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="Circuito de potencia v0.7 (10/10/2026): dos fuentes separadas, unidas solo por GND" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Motores" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1180" height="470" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;LiPo Zeee 3S&lt;/b&gt;&lt;br&gt;11,1 V (9,9–12,6 V)&lt;br&gt;8000 mAh · 88,8 Wh · 100C&lt;br&gt;XT60 · &lt;b&gt;sin BMS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="190" height="90" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Indicador de barras&lt;/b&gt;&lt;br&gt;en el conector de balanceo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="190" height="50" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Fusible de auto 20 A&lt;/b&gt;&lt;br&gt;pegado al XT60&lt;br&gt;protección contra cortos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="180" height="70" as="geometry" /></mxCell><mxCell id="c40" value="&lt;b&gt;Selector WEG&lt;/b&gt;&lt;br&gt;2 NA en paralelo&lt;br&gt;ON/OFF de mo