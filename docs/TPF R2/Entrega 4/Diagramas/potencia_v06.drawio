e="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="bloque B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c31" value="La seta corta el + del bus de 12 V (bloque A): los cinco IBT-2 y el buck quedan sin tensión aunque se cuelgue el firmware (rueda libre). Solo para emergencias: el ON/OFF diario es el selector. El brazo lo desarma &lt;i&gt;mision&lt;/i&gt; al ver SETA. BATERIA_BAJA avisa pero no frena: parar a mano." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1140" height="50" as="geometry" /></mxCell><mxCell id="c32" value="Lógica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#bbbbbb;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1180" height="150" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;Power bank Xiaomi PB2020MI&lt;/b&gt;&lt;br&gt;20000 mAh · 5 V 3 A (15 W)&lt;br&gt;protegido · cable USB-C" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="220" height="80" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Raspberry Pi 5&lt;/b&gt;&lt;br&gt;ROS 2 Jazzy · YOLO + estéreo&lt;br&gt;USB + ventilador ≤ 600 mA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="210" height="80" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;ESP32-S3&lt;/b&gt; (base) y &lt;b&gt;ESP32-WROOM&lt;/b&gt; (brazo)&lt;br&gt;por USB · encoders, IMU, HC-SR04&lt;br&gt;y lógica de los IBT-2 desde sus 5 V/3,3 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="610" y="570" width="290" height="80" as="geometry" /></mxCell><mxCell id="c36" value="&lt;b&gt;GND común:&lt;/b&gt; GND de la S3 y de la WROOM a la bornera de GND del bus de motores. Los positivos de la LiPo y del power bank nunca se tocan." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="930" y="570" width="250" height="80" as="geometry" /></mxCell><mxCell id="c37" value="5 V USB-C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="USB (micro-ROS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>